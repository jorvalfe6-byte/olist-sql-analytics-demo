/// Grano: 1 fila por pedido (mart.fact_order).
table Pedidos
	lineageTag: 7888e2c8-280a-821d-7dd2-1bea8515fc9c

	/// Pedidos válidos: excluye cancelados y no disponibles.
	measure 'Pedidos válidos' = CALCULATE(COUNTROWS(Pedidos), Pedidos[es_valido] = 1)
		formatString: #,0
		lineageTag: 44e09196-6fe5-5e1f-8b8f-b58e08435424

	/// Suma del precio de los ítems de pedidos válidos, sin flete.
	measure GMV = CALCULATE(SUM(Pedidos[valor_mercancia]), Pedidos[es_valido] = 1)
		formatString: "R$ "#,0
		lineageTag: b0e44de8-54a1-d947-a53f-6121da940406

	measure 'Ticket promedio' = DIVIDE([GMV], [Pedidos válidos])
		formatString: "R$ "#,0.00
		lineageTag: b2fca315-41fc-d3c7-e97a-efe787816e26

	/// Ticket promedio sin el único pedido válido que no tiene pago registrado.
	measure 'Ticket promedio con pago' = CALCULATE([Ticket promedio], KEEPFILTERS(Pedidos[Tramo de cuotas] <> "Sin pago"))
		formatString: "R$ "#,0.00
		lineageTag: cc75ec7c-384d-f1bc-5281-3a5ff7d9c4cc

	/// GMV solo de enero 2017 a agosto 2018: 2016 trae pedidos de prueba y septiembre 2018 viene cortado.
	measure 'GMV (meses completos)' = IF(MIN(Calendario[mes_completo]) = 1, [GMV])
		formatString: "R$ "#,0
		lineageTag: 6d6974f6-767f-d2b9-09d2-b67cf9c60936

	/// Personas distintas (customer_unique_id) con al menos un pedido válido.
	measure Clientes = CALCULATE(DISTINCTCOUNT(Pedidos[cliente_id]), Pedidos[es_valido] = 1)
		formatString: #,0
		lineageTag: 02af7ef1-114a-c50a-03e5-4a33052fe24f

	/// Clientes con más de un pedido válido sobre el total de clientes.
	measure '% clientes recurrentes' = ```
			VAR clientes = CALCULATETABLE(VALUES(Pedidos[cliente_id]), Pedidos[es_valido] = 1)
			VAR recurrentes =
			    COUNTROWS(
			        FILTER(clientes, CALCULATE(COUNTROWS(Pedidos), Pedidos[es_valido] = 1) > 1)
			    )
			RETURN DIVIDE(recurrentes, COUNTROWS(clientes))
			```
		formatString: 0.0%
		lineageTag: c3dac641-23f8-8d41-09bd-29eb0887d607

	measure 'GMV var. % año anterior' = ```
			VAR actual = [GMV]
			VAR anterior = CALCULATE([GMV], SAMEPERIODLASTYEAR(Calendario[Fecha]))
			RETURN DIVIDE(actual - anterior, anterior)
			```
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 3ba6f6d9-ad69-a9e2-09bf-76d15dcb7d10

	measure Entregas = CALCULATE(COUNTROWS(Pedidos), Pedidos[es_valido] = 1, Pedidos[entregado] = 1)
		formatString: #,0
		displayFolder: Logística
		lineageTag: 1051457a-7b64-403d-94a9-8a28ec967395

	/// Entregas que llegaron después de la fecha prometida.
	measure '% entregas tarde' = CALCULATE(AVERAGE(Pedidos[tarde]), Pedidos[es_valido] = 1, Pedidos[entregado] = 1)
		formatString: 0.0%
		displayFolder: Logística
		lineageTag: e8402565-0b10-a98f-1b64-6a45006ce344

	measure 'Días de entrega promedio' = CALCULATE(AVERAGE(Pedidos[dias_entrega]), Pedidos[es_valido] = 1, Pedidos[entregado] = 1)
		formatString: 0.0
		displayFolder: Logística
		lineageTag: 2cc74810-18f3-72b6-2db0-2ef3ad91ff95

	measure 'Reseña promedio' = CALCULATE(AVERAGE(Pedidos[resena]), Pedidos[es_valido] = 1)
		formatString: 0.00
		displayFolder: Satisfacción
		lineageTag: 1bb11ad8-2bd8-b83d-3224-2372d527ba82

	/// Reseñas de 1 o 2 estrellas sobre entregas con reseña.
	measure '% reseñas negativas' = ```
			VAR conResena =
			    CALCULATE(COUNTROWS(Pedidos), Pedidos[es_valido] = 1, Pedidos[entregado] = 1, NOT ISBLANK(Pedidos[resena]))
			VAR negativas =
			    CALCULATE(
			        COUNTROWS(Pedidos),
			        Pedidos[es_valido] = 1, Pedidos[entregado] = 1, NOT ISBLANK(Pedidos[resena]), Pedidos[resena] <= 2
			    )
			RETURN DIVIDE(negativas, conResena)
			```
		formatString: 0.0%
		displayFolder: Satisfacción
		lineageTag: 8eaf8e83-b220-7ce9-854a-2c42021b52fd

