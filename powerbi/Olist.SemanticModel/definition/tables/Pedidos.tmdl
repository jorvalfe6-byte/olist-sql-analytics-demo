	partition Pedidos = m
		mode: import
		source =
				let
				    Archivo = "fact_pedido.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"pedido_id", type text}, {"cliente_id", type text}, {"fecha_compra", type date}, {"estado_cliente", type text}, {"estado_pedido", type text}, {"es_valido", Int64.Type}, {"items", Int64.Type}, {"valor_mercancia", Currency.Type}, {"flete", Currency.Type}, {"valor_pagado", Currency.Type}, {"medio_pago", type text}, {"cuotas", Int64.Type}, {"tramo_cuotas", type text}, {"dias_entrega", type number}, {"dias_prometidos", Int64.Type}, {"entregado", Int64.Type}, {"tarde", Int64.Type}, {"dias_atraso", Int64.Type}, {"tramo_atraso", type text}, {"resena", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
