	partition Calendario = m
		mode: import
		source =
				let
				    Archivo = "dim_fecha.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"fecha", type date}, {"anio", Int64.Type}, {"trimestre", Int64.Type}, {"mes_num", Int64.Type}, {"anio_mes", type text}, {"mes", type text}, {"dia_semana_num", Int64.Type}, {"dia_semana", type text}, {"mes_completo", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
